<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted services often live at http://192.168.x.x or http://service:port on a home network or
     tailnet, and some use self-signed certificates installed as user CAs. Allow both. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
